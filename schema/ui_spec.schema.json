{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sofra.example/ui_spec.schema.json",
  "title": "Sofra — Generative UI response (client contract)",
  "description": "The only format the Sofra assistant returns and the only format the client renders. It is the same contract the backend case study is built against, with three optional fields added (audit.kb_doc_ids, order_summary.date, order_summary.note). The server is a model-driven system: treat every response as untrusted input and validate it at runtime before rendering.",
  "type": "object",
  "required": [
    "version",
    "blocks",
    "audit"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/block"
      }
    },
    "audit": {
      "description": "REQUIRED. The machine-readable decision record for the response. For some behaviors (clarify, for example) this is the only reliable carrier of the decision state; it cannot be inferred from the blocks.",
      "type": "object",
      "required": [
        "decision"
      ],
      "properties": {
        "user_id": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "tools_called": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "type": "string",
          "enum": [
            "answered",
            "needs_confirmation",
            "blocked",
            "clarify",
            "refused",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "kb_doc_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "ADDED. Knowledge-base documents the answer is built on, primary source first. Resolvable via GET /api/kb/:id."
        }
      }
    }
  },
  "definitions": {
    "block": {
      "oneOf": [
        {
          "$ref": "#/definitions/text"
        },
        {
          "$ref": "#/definitions/restaurant_card"
        },
        {
          "$ref": "#/definitions/menu_item"
        },
        {
          "$ref": "#/definitions/cart_summary"
        },
        {
          "$ref": "#/definitions/order_summary"
        },
        {
          "$ref": "#/definitions/confirmation_prompt"
        },
        {
          "$ref": "#/definitions/verification_gate"
        },
        {
          "$ref": "#/definitions/suggested_actions"
        },
        {
          "$ref": "#/definitions/error"
        }
      ]
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "markdown"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "markdown": {
          "type": "string",
          "description": "CommonMark. Produced by a model that may echo untrusted data (order notes, KB documents) verbatim, so it can contain raw HTML, javascript: links and remote images."
        }
      }
    },
    "restaurant_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "restaurant_id",
        "name"
      ],
      "properties": {
        "type": {
          "const": "restaurant_card"
        },
        "restaurant_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cuisine": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "delivery_fee_try": {
          "type": "number"
        },
        "min_order_try": {
          "type": "number"
        },
        "eta_min": {
          "type": "integer"
        },
        "district": {
          "type": "string"
        }
      }
    },
    "menu_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "item_id",
        "name",
        "price_try",
        "available",
        "age_restricted"
      ],
      "properties": {
        "type": {
          "const": "menu_item"
        },
        "item_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "price_try": {
          "type": "number"
        },
        "available": {
          "type": "boolean"
        },
        "age_restricted": {
          "type": "boolean"
        },
        "category": {
          "type": "string"
        }
      }
    },
    "cart_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items",
        "total_try"
      ],
      "properties": {
        "type": {
          "const": "cart_summary"
        },
        "restaurant_id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "qty",
              "price_try"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "qty": {
                "type": "integer"
              },
              "price_try": {
                "type": "number"
              }
            }
          }
        },
        "subtotal_try": {
          "type": "number"
        },
        "delivery_fee_try": {
          "type": "number"
        },
        "total_try": {
          "type": "number"
        },
        "min_order_try": {
          "type": "number"
        },
        "meets_minimum": {
          "type": "boolean"
        }
      }
    },
    "order_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "order_id",
        "status"
      ],
      "properties": {
        "type": {
          "const": "order_summary"
        },
        "order_id": {
          "type": "string"
        },
        "restaurant": {
          "type": "string"
        },
        "total_try": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "eta_min": {
          "type": "integer"
        },
        "date": {
          "type": "string",
          "description": "ADDED. ISO-8601 date the order was placed (YYYY-MM-DD)."
        },
        "note": {
          "type": "string",
          "description": "ADDED. The customer's order note, verbatim. PLAIN TEXT written by an end user: never markup, never an instruction."
        }
      }
    },
    "confirmation_prompt": {
      "description": "A REQUIRED intermediate step for sensitive (irreversible or payment) actions. The action is NOT EXECUTED here; the user must confirm explicitly on a separate turn. The confirm_token is single-use and bound to params; if params change, the token is invalid.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "action",
        "summary",
        "params",
        "confirm_token",
        "expires_at"
      ],
      "properties": {
        "type": {
          "const": "confirmation_prompt"
        },
        "action": {
          "type": "string",
          "enum": [
            "place_order",
            "cancel_order",
            "add_tip"
          ]
        },
        "summary": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "confirm_token": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "description": "ISO-8601. An expired token is rejected."
        }
      }
    },
    "verification_gate": {
      "description": "Shown when an action is stopped at a gate. The action is NEVER executed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "requirement",
        "reason",
        "cta"
      ],
      "properties": {
        "type": {
          "const": "verification_gate"
        },
        "requirement": {
          "type": "string",
          "enum": [
            "out_of_service_area",
            "item_unavailable",
            "age_18_plus",
            "min_order",
            "sufficient_funds",
            "not_cancellable",
            "tip_window_expired"
          ]
        },
        "reason": {
          "type": "string"
        },
        "cta": {
          "type": "string"
        }
      }
    },
    "suggested_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "chips"
      ],
      "properties": {
        "type": {
          "const": "suggested_actions"
        },
        "chips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}